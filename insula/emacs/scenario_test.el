;;; scenario_test.el -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(load-file "/workspace/torch_dojo/insula/emacs/scenario.el")

(ert-deftest dojo-scenario-custom-one-cell-runs-five-steps ()
  (let* ((_ (make-directory "/workspace/torch_dojo/target/insula/scenario" t))
         (dir (make-temp-file "/workspace/torch_dojo/target/insula/scenario/one-" t))
         (process-environment (cons (concat "DOJO_SCENARIO_DIR=" dir) process-environment)))
    (unwind-protect
        (progn
          (with-temp-file (expand-file-name "run.org" dir)
            (insert "* Lesson\n#+BEGIN_SRC python\nprint(7)\n#+END_SRC\n"))
          (torch-dojo-scenario-open)
          (should (= (length torch-dojo-scenario-steps) 5))
          (let ((sent nil))
            (cl-letf (((symbol-function 'torch-dojo-scenario-setup) (lambda () "ready"))
                      ((symbol-function 'torch-dojo-scenario-transport-connect)
                       (lambda (yes _no) (funcall yes 'client "kernel-one")))
                      ((symbol-function 'torch-dojo-scenario-transport-execute)
                       (lambda (client code yes _no)
                         (setq sent (list client code))
                         (funcall yes '(:stdout "7\n" :text "" :mime nil))))
                      ((symbol-function 'torch-dojo-scenario-transport-shutdown)
                       (lambda (_client done) (funcall done t nil)))
                      ((symbol-function 'torch-dojo-scenario-kernel-gone-p)
                       (lambda (id) (equal id "kernel-one"))))
              (dotimes (_ 5) (torch-dojo-scenario-next))
              (should (equal sent '(client "print(7)\n")))
              (should (= torch-dojo-scenario-index 5))
              (should (string-match-p "completed-cells=1" (cdr (assq 3 torch-dojo-scenario-history))))
              (should (string-match-p "7" (buffer-string))))))
      (when-let ((buf (get-file-buffer (expand-file-name "run.org" dir)))) (kill-buffer buf))
      (delete-directory dir t))))

(ert-deftest dojo-scenario-multiple-cells-advance-once-with-one-kernel ()
  (let* ((_ (make-directory "/workspace/torch_dojo/target/insula/scenario" t))
         (dir (make-temp-file "/workspace/torch_dojo/target/insula/scenario/many-" t))
         (process-environment (cons (concat "DOJO_SCENARIO_DIR=" dir) process-environment))
         (sent nil) (connections 0))
    (unwind-protect
        (progn
          (with-temp-file (expand-file-name "run.org" dir)
            (insert "* Lesson\nIntro.\n#+NAME: first\n#+BEGIN_SRC python\nx = 2\n#+END_SRC\n** Deep\nSecond.\n#+BEGIN_SRC python\nprint(x + 3)\n#+END_SRC\n"))
          (torch-dojo-scenario-open)
          (should (= (length torch-dojo-scenario-steps) 6))
          (should (string-match-p "Lesson" (torch-dojo-scenario-step-name 2)))
          (should (string-match-p "first" (torch-dojo-scenario-step-name 2)))
          (should (string-match-p "Deep" (torch-dojo-scenario-step-name 3)))
          (cl-letf (((symbol-function 'torch-dojo-scenario-setup) (lambda () "ready"))
                    ((symbol-function 'torch-dojo-scenario-transport-connect)
                     (lambda (yes _no)
                       (cl-incf connections) (funcall yes 'shared-client "shared-kernel")))
                    ((symbol-function 'torch-dojo-scenario-transport-execute)
                     (lambda (client code yes _no)
                       (push (list client torch-dojo-scenario-kernel-id code) sent)
                       (funcall yes '(:stdout "ok" :text "" :mime nil)))))
            (dotimes (index 4)
              (torch-dojo-scenario-next)
              (should (= torch-dojo-scenario-index (1+ index))))
            (should (= connections 1))
            (should (equal (mapcar #'caddr (reverse sent))
                           '("x = 2\n" "print(x + 3)\n")))
            (should (equal (mapcar #'cadr sent) '("shared-kernel" "shared-kernel")))
            (torch-dojo-scenario-previous)
            (should (= torch-dojo-scenario-index 4))
            (should (= (length sent) 2))))
      (when-let ((buf (get-file-buffer (expand-file-name "run.org" dir)))) (kill-buffer buf))
      (delete-directory dir t))))

(defmacro dojo-scenario-with-run (&rest body)
  `(let* ((_ (make-directory "/workspace/torch_dojo/target/insula/scenario" t))
          (dir (make-temp-file "/workspace/torch_dojo/target/insula/scenario/ert-" t))
          (process-environment (cons (concat "DOJO_SCENARIO_DIR=" dir) process-environment)))
     (unwind-protect
         (progn
           (copy-file "/workspace/torch_dojo/insula/scenarios/default.org"
                      (expand-file-name "run.org" dir))
           (torch-dojo-scenario-open)
           ,@body)
       (when (buffer-live-p (get-file-buffer (expand-file-name "run.org" dir)))
         (kill-buffer (get-file-buffer (expand-file-name "run.org" dir))))
       (delete-directory dir t))))

(ert-deftest dojo-scenario-one-next-runs-one-setup-step ()
  (dojo-scenario-with-run
   (cl-letf (((symbol-function 'torch-dojo-scenario-setup)
              (lambda () "ready")))
     (torch-dojo-scenario-next)
     (should (= torch-dojo-scenario-index 1))
     (should (equal (cdr (assq 0 torch-dojo-scenario-history)) "ready"))
     (should-not torch-dojo-scenario-client))))

