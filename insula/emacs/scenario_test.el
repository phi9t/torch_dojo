(ert-deftest dojo-scenario-setup-describes-environment-without-token ()
  (dojo-scenario-with-run
   (let ((process-environment (cons "DOJO_VERIFY_PORT=8898" process-environment)))
    (cl-letf (((symbol-function 'torch-dojo-scenario-token)
             (lambda () "secret-value"))
             ((symbol-function 'torch-dojo-scenario-api)
              (lambda (_path) '((kernelspecs . ((torch-dojo-gpu . t)))))))
     (let ((summary (torch-dojo-scenario-setup)))
       (should (string-match-p "127.0.0.1:8898" summary))
       (should (string-match-p "torch-dojo-gpu" summary))
       (should (string-match-p "0600" summary))
       (should-not (string-match-p "secret-value" summary)))))))

(ert-deftest dojo-scenario-connect-and-cell-reuse-one-client ()
  (dojo-scenario-with-run
   (let ((connects 0) (sent nil))
     (cl-letf (((symbol-function 'torch-dojo-scenario-setup) (lambda () "ready"))
               ((symbol-function 'torch-dojo-scenario-transport-connect)
                (lambda (success _error)
                  (cl-incf connects) (funcall success 'fake-client "kernel-1")))
               ((symbol-function 'torch-dojo-scenario-transport-execute)
                (lambda (_client code success _error)
                  (push code sent)
                  (funcall success '(:stdout "hello" :text "42" :mime ("image/png"))))))
       (torch-dojo-scenario-next)
       (torch-dojo-scenario-next)
       (should (= torch-dojo-scenario-index 2))
       (goto-char (point-min))
       (re-search-forward "print(f\"executable=")
       (replace-match "print('edited')" t t)
       (torch-dojo-scenario-next)
       (should (= connects 1))
       (should (= (length sent) 1))
       (should (string-match-p "print('edited')" (car sent)))
       (should (string-match-p "hello" (buffer-string)))
       (should (string-match-p "42" (buffer-string)))
       (should (string-match-p "image/png" (buffer-string)))))))

(ert-deftest dojo-scenario-timeout-pauses-without-resending ()
  (dojo-scenario-with-run
   (let ((sends 0))
     (cl-letf (((symbol-function 'torch-dojo-scenario-setup) (lambda () "ready"))
               ((symbol-function 'torch-dojo-scenario-transport-connect)
                (lambda (success _error) (funcall success 'fake-client "kernel-1")))
               ((symbol-function 'torch-dojo-scenario-transport-execute)
                (lambda (_client _code _success error)
                  (cl-incf sends) (funcall error 'unknown "outcome unknown"))))
       (torch-dojo-scenario-next)
       (torch-dojo-scenario-next)
       (torch-dojo-scenario-next)
       (should torch-dojo-scenario-failed)
       (should (string-match-p "outcome unknown" (buffer-string)))
       (should-error (torch-dojo-scenario-next))
       (should (= sends 1))))))

(ert-deftest dojo-scenario-missing-token-pauses-before-connect ()
  (dojo-scenario-with-run
   (cl-letf (((symbol-function 'torch-dojo-scenario-token)
              (lambda () (error "Jupyter token file missing")))
             ((symbol-function 'torch-dojo-scenario-transport-connect)
              (lambda (&rest _) (error "connect should not happen"))))
     (torch-dojo-scenario-next)
     (should torch-dojo-scenario-failed)
     (should (= torch-dojo-scenario-index 0))
     (should (string-match-p "token file missing"
                             torch-dojo-scenario-last-error))
     (should (string-match-p "token file missing" torch-dojo-scenario-last-error)))))

