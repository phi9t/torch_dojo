(ert-deftest dojo-scenario-restart-preserves-cell-edits-and-clears-results ()
  (dojo-scenario-with-run
   (let ((stopped nil))
     (cl-letf (((symbol-function 'torch-dojo-scenario-setup) (lambda () "ready"))
               ((symbol-function 'torch-dojo-scenario-transport-shutdown)
                (lambda (_client done) (setq stopped t) (funcall done t nil))))
       (torch-dojo-scenario-next)
       (goto-char (point-min))
       (re-search-forward "print(f\"executable=")
       (replace-match "print('keep my edit')" t t)
       (setq torch-dojo-scenario-client 'owned)
       (torch-dojo-scenario-restart)
       (should stopped)
       (should (= torch-dojo-scenario-index 0))
       (should-not torch-dojo-scenario-client)
       (should (string-match-p "keep my edit" (buffer-string)))
       (should-not (string-match-p "rootfs=" (buffer-string)))))))

(ert-deftest dojo-scenario-quit-cleans-owned-kernel-after-failure ()
  (dojo-scenario-with-run
   (let ((stopped nil) (exit-status nil))
     (setq torch-dojo-scenario-client 'owned
           torch-dojo-scenario-failed t)
     (cl-letf (((symbol-function 'torch-dojo-scenario-transport-shutdown)
                (lambda (_client done) (setq stopped t) (funcall done t nil)))
               ((symbol-function 'torch-dojo-scenario-exit)
                (lambda (status) (setq exit-status status))))
       (torch-dojo-scenario-quit)
       (should stopped)
       (should (= exit-status 1))))))

(ert-deftest dojo-scenario-quit-records-separate-cleanup-error ()
  (dojo-scenario-with-run
   (let ((exit-status nil))
     (setq torch-dojo-scenario-client 'owned
           torch-dojo-scenario-failed t)
     (cl-letf (((symbol-function 'torch-dojo-scenario-transport-shutdown)
                (lambda (_client done) (funcall done nil "shutdown refused")))
               ((symbol-function 'torch-dojo-scenario-exit)
                (lambda (status) (setq exit-status status))))
       (torch-dojo-scenario-quit)
       (should (= exit-status 1))
       (should (file-exists-p (expand-file-name
                               "cleanup-error" (torch-dojo-scenario-dir))))
       (should (string-match-p "cleanup error: shutdown refused"
                               torch-dojo-scenario-status-text))))))

(ert-deftest dojo-scenario-cleanup-confirms-owned-id-absent ()
  (dojo-scenario-with-run
   (setq torch-dojo-scenario-index 6
         torch-dojo-scenario-client 'owned
         torch-dojo-scenario-kernel-id "owned-id")
   (cl-letf (((symbol-function 'torch-dojo-scenario-transport-shutdown)
              (lambda (_client done) (funcall done t nil)))
             ((symbol-function 'torch-dojo-scenario-api)
              (lambda (_path) '(((id . "other-id"))))))
     (torch-dojo-scenario-next)
     (should (= torch-dojo-scenario-index 7))
     (should-not torch-dojo-scenario-client)
     (should (string-match-p "owned-id absent" (cdr (assq 6 torch-dojo-scenario-history))))
     (should (equal "Cleanup complete" (alist-get 'status (torch-dojo-scenario-snapshot)))))))


(ert-deftest dojo-scenario-owns-freshness-across-edits-and-restart ()
  (dojo-scenario-with-run
   (cl-letf (((symbol-function 'torch-dojo-scenario-setup) (lambda () "ready"))
             ((symbol-function 'torch-dojo-scenario-transport-connect)
              (lambda (yes _no) (funcall yes 'client "kernel")))
             ((symbol-function 'torch-dojo-scenario-transport-execute)
              (lambda (_client _code yes _no) (funcall yes '(:stdout "original result"))))
             ((symbol-function 'torch-dojo-scenario-transport-shutdown)
              (lambda (_client done) (funcall done t nil))))
     (dotimes (_ 3) (torch-dojo-scenario-next))
     (let ((original (torch-dojo-scenario-org-source "cell-1")))
       (should (eq :false (alist-get 'stale (aref (alist-get 'steps (torch-dojo-scenario-snapshot)) 2))))
       ;; Direct Org editing must have the same freshness semantics as the TUI.
       (torch-dojo-scenario-org-set-source "cell-1" "print('edited')\n")
       (let ((step (aref (alist-get 'steps (torch-dojo-scenario-snapshot)) 2)))
         (should (eq t (alist-get 'stale step)))
         (should (equal "original result" (alist-get 'stdout (alist-get 'output step)))))
       (torch-dojo-scenario-set-source "cell-1" original)
       (should (eq t (alist-get 'stale (aref (alist-get 'steps (torch-dojo-scenario-snapshot)) 2))))
       (torch-dojo-scenario-view-completed 2)
       (should (= 3 torch-dojo-scenario-index))
       (dolist (invalid '(-1 3 "2" 1.5))
         (should-error (torch-dojo-scenario-view-completed invalid)))
       (torch-dojo-scenario-restart)
       (should (eq :false (alist-get 'stale (aref (alist-get 'steps (torch-dojo-scenario-snapshot)) 2))))
       (torch-dojo-scenario-set-source "cell-1" "print('fresh')\n")
       (dotimes (_ 3) (torch-dojo-scenario-next))
       (should (eq :false (alist-get 'stale (aref (alist-get 'steps (torch-dojo-scenario-snapshot)) 2))))))))

