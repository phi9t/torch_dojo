;;; emacs_probe.el --- Disposable live-session experiment -*- lexical-binding: t; -*-
(require 'cl-lib)
(require 'subr-x)
(require 'json)
(setq user-emacs-directory (expand-file-name "~/.emacs.d/"))
(let ((build (format "~/.emacs.d/.local/straight/build-%d.%d" emacs-major-version emacs-minor-version)))
  (dolist (dir (directory-files build t directory-files-no-dot-files-regexp))
    (when (file-directory-p dir) (add-to-list 'load-path dir))))
(require 'jupyter)
(require 'jupyter-server)
(require 'jupyter-client)
(require 'jupyter-messages)
(setq jupyter-eval-use-overlays nil)
(setq jupyter-eval-short-result-display-function #'message)
(defconst dojo-probe-directory "/workspace/torch_dojo/target/insula/research/emacs/")
(defvar dojo-probe-evidence nil)
(defun dojo-probe-record (name value)
  (push (cons name value) dojo-probe-evidence)
  (princ (format "%s: %S\n" name value)))
(defun dojo-probe-stop (client)
  ;; Use explicit I/O stop: this checkout reverses connect/disconnect actions.
  (jupyter-run-with-io (jupyter-kernel-io client) (jupyter-publish 'stop)))
(defun dojo-probe-start (client)
  (jupyter-run-with-io (jupyter-kernel-io client) (jupyter-publish 'start)))
(defun dojo-probe-check-request (request)
  (unless (jupyter-wait-until-idle request 60)
    (error "Execution timed out: %s" (jupyter-request-id request)))
  (let ((reply (jupyter-find-message "execute_reply" (jupyter-request-messages request))))
    (unless (equal (plist-get (jupyter-message-content reply) :status) "ok")
      (error "Execution failed: %S" reply)))
  request)
(defun dojo-probe-expression (client code)
  (with-temp-buffer
    (setq-local jupyter-current-client client)
    (let* ((request (dojo-probe-check-request (jupyter-eval-string code)))
           (result (jupyter-find-message "execute_result" (jupyter-request-messages request))))
      (jupyter-message-data result :text/plain))))
(defvar dojo-probe-debug-sequence 0)
(defun dojo-probe-debug (client command &optional arguments)
  ;; Research-only channel override; upstream routes unknown requests to shell.
  (let ((original (symbol-function 'jupyter-channel-from-request-type)))
    (cl-letf (((symbol-function 'jupyter-channel-from-request-type)
               (lambda (type)
                 (if (equal type "debug_request") "control" (funcall original type)))))
      (jupyter-run-with-client client
        (jupyter-mlet* ((request (jupyter-sent
                               (jupyter-with-client-handlers nil
                                 (jupyter-request "debug_request" :seq (cl-incf dojo-probe-debug-sequence) :type "request"
                                                  :command command :arguments (or arguments jupyter--empty-dict))))))
          (let* ((reply (jupyter-wait-until request "debug_reply" (lambda (_message) t) 15))
                 (content (jupyter-message-content reply)))
            (unless (eq (plist-get content :success) t)
              (error "Debugger %s failed: %S" command content))
            (jupyter-return (plist-get content :body))))))))
(defun dojo-probe-stopped-thread (client)
  (let ((deadline (+ (float-time) 30)) thread)
    (while (and (not thread) (< (float-time) deadline))
      (let ((stopped (plist-get (dojo-probe-debug client "debugInfo") :stoppedThreads)))
        (when (> (length stopped) 0) (setq thread (elt stopped 0))))
      (unless thread (sleep-for 0.1)))
    (or thread (error "Debugger did not stop within 30 seconds"))))
(defun dojo-probe-frame (client thread)
  (elt (plist-get (dojo-probe-debug client "stackTrace" `(:threadId ,thread)) :stackFrames) 0))
(defun dojo-probe-wait-frame (client thread path line)
  (let ((deadline (+ (float-time) 30)) frame)
    (while (and (not frame) (< (float-time) deadline))
      (condition-case nil
          (let ((candidate (dojo-probe-frame client thread)))
            (when (and (= (plist-get candidate :line) line)
                       (equal (plist-get (plist-get candidate :source) :path) path))
              (setq frame candidate)))
        (error nil))
      (unless frame (sleep-for 0.1)))
    (or frame (error "Debugger did not reach %s:%s" path line))))
(defun dojo-probe-debug-workflow (client)
  (dojo-probe-debug client "initialize" '(:clientID "torch-dojo-emacs-research" :adapterID "python"
                                         :pathFormat "path" :linesStartAt1 t :columnsStartAt1 t
                                         :supportsVariableType t))
  (dojo-probe-debug client "attach" '(:justMyCode :json-false))
  (with-temp-buffer
    (python-mode)
    (setq-local jupyter-current-client client)
    (insert "def emacs_research_step(x):\n    local_tensor = x + 2\n    result = local_tensor.sum()\n    return result\nemacs_research_result = emacs_research_step(tensor)")
    (let* ((code (buffer-string))
           (path (plist-get (dojo-probe-debug client "dumpCell" `(:code ,code)) :sourcePath))
           (breaks (dojo-probe-debug client "setBreakpoints" `(:source (:path ,path) :breakpoints [(:line 3)])))
           (request (jupyter-eval-region nil (point-min) (point-max)))
           (thread (dojo-probe-stopped-thread client))
           (frame (dojo-probe-frame client thread))
           (frame-id (plist-get frame :id)))
      (unless (and (= (plist-get frame :line) 3)
                   (equal (plist-get (plist-get frame :source) :path) path))
        (error "Wrong breakpoint source/line: %S" frame))
      (let* ((scopes (plist-get (dojo-probe-debug client "scopes" `(:frameId ,frame-id)) :scopes))
             (locals (cl-find "Locals" scopes :key (lambda (scope) (plist-get scope :name)) :test #'equal))
             (variables (plist-get (dojo-probe-debug client "variables"
                                    `(:variablesReference ,(plist-get locals :variablesReference))) :variables))
             (value (dojo-probe-debug client "evaluate"
                        `(:expression "(tuple(local_tensor.shape), str(local_tensor.device), bool(torch.equal(local_tensor, x + 2)))"
                          :frameId ,frame-id :context "repl"))))
        (unless (equal (plist-get value :result) "((4, 16), 'cuda:0', True)")
          (error "Unexpected paused tensor value: %S" value))
        (dojo-probe-record "emacs-breakpoint-frame" `(:source ,path :breakpoints ,breaks :frame ,frame
                                                       :local-names ,(vconcat (mapcar (lambda (variable) (plist-get variable :name)) variables))
                                                       :evaluation ,value)))
      (dojo-probe-stop client)
      (sleep-for 0.5)
      (dojo-probe-start client)
      (let* ((info (dojo-probe-debug client "debugInfo"))
             (fresh-frame (dojo-probe-frame client thread))
             (value (dojo-probe-debug client "evaluate" `(:expression "local_tensor.shape"
                                                           :frameId ,(plist-get fresh-frame :id) :context "repl"))))
        (unless (member thread (append (plist-get info :stoppedThreads) nil))
          (error "Pause lost after reconnect"))
        (dojo-probe-record "emacs-paused-reconnect" `(:debug-info ,info :frame ,fresh-frame :evaluation ,value)))
      (dojo-probe-debug client "next" `(:threadId ,thread))
      (let ((stepped-frame (dojo-probe-wait-frame client thread path 4)))
        (dojo-probe-record "emacs-stepped-frame" stepped-frame))
      (dojo-probe-debug client "continue" `(:threadId ,thread))
      (dojo-probe-record "emacs-debug-original-request-idle" (and (jupyter-wait-until-idle request 10) t))
      (dojo-probe-record "emacs-debug-completed-state" (dojo-probe-expression client
        "(bool(torch.equal(emacs_research_result, (tensor + 2).sum())), id(model) == original_model_id, id(tensor) == original_tensor_id)"))
      (erase-buffer)
      (insert (replace-regexp-in-string "    result =" "    # edited source moves breakpoint\n    result ="
                (replace-regexp-in-string (regexp-quote "x + 2") "x + 3" code t t) t t))
      (let* ((edited (buffer-string))
             (new-path (plist-get (dojo-probe-debug client "dumpCell" `(:code ,edited)) :sourcePath)))
        (when (equal new-path path) (error "Edited source should use a distinct temporary path"))
        (dojo-probe-debug client "setBreakpoints" `(:source (:path ,new-path) :breakpoints [(:line 4)]))
        (let* ((edited-request (jupyter-eval-region nil (point-min) (point-max)))
               (edited-thread (dojo-probe-stopped-thread client))
               (edited-frame (dojo-probe-wait-frame client edited-thread new-path 4))
               (value (dojo-probe-debug client "evaluate" `(:expression "bool(torch.equal(local_tensor, x + 3))"
                                                             :frameId ,(plist-get edited-frame :id) :context "repl"))))
          (unless (and (= (plist-get edited-frame :line) 4)
                       (equal (plist-get (plist-get edited-frame :source) :path) new-path)
                       (equal (plist-get value :result) "True"))
            (error "Edited source mapping/value incorrect: %S %S" edited-frame value))
          (dojo-probe-record "emacs-edited-source-breakpoint" `(:old-path ,path :new-path ,new-path :frame ,edited-frame :evaluation ,value))
          (dojo-probe-debug client "continue" `(:threadId ,edited-thread))
          (dojo-probe-check-request edited-request))))))
(let* ((token (string-trim (with-temp-buffer
                            (insert-file-contents "/workspace/torch_dojo/target/insula/shared/token")
                            (buffer-string))))
       (auth `(("Authorization" . ,(concat "token " token))))
       (jupyter-api-authentication-method auth)
       (server (jupyter-server :url "http://127.0.0.1:8899" :auth auth))
       (kernel (jupyter-kernel :server server :spec "torch-dojo-gpu"))
       (client (jupyter-client kernel 'jupyter-kernel-client))
       (kernel-id (jupyter-server-kernel-id kernel))
       (second-client nil)
       (third-client nil))
  (unwind-protect
      (progn
        (dojo-probe-record "emacs-version" emacs-version)
        (dojo-probe-record "kernel-id" kernel-id)
        (with-temp-buffer
          (insert "import torch, os, sys, ipykernel, jupyter_server\n"
                  "probe_label = 'torch-dojo-emacs-research'\n"
                  "model = torch.nn.Linear(16, 8).cuda()\n"
                  "tensor = torch.randn(4, 16, device='cuda')\n"
                  "original_tensor_id = id(tensor)\n"
                  "original_model_id = id(model)\n"
                  "submission_count = 0\n")
          (setq-local jupyter-current-client client)
          (dojo-probe-check-request (jupyter-eval-buffer (current-buffer))))
        (dojo-probe-record "versions" (dojo-probe-expression client
          "{'python': sys.version, 'torch': torch.__version__, 'cuda': torch.version.cuda, 'ipykernel': ipykernel.__version__, 'jupyter_server': jupyter_server.__version__, 'device': torch.cuda.get_device_name(), 'cwd': os.getcwd()}"))
        (dojo-probe-record "kernel-info-debugger" (plist-get (jupyter-kernel-info client) :debugger))
        (dojo-probe-record "emacs-control-debug-info" (dojo-probe-debug client "debugInfo"))
        (with-temp-buffer
          (insert "raise RuntimeError('excluded prefix')\n")
          (let ((begin (point)))
            (insert "submission_count += 1\nresult = model(tensor)\nassert result.is_cuda\n")
            (let ((end (point)))
              (insert "raise RuntimeError('excluded suffix')\n")
              (setq-local jupyter-current-client client)
              (dojo-probe-check-request (jupyter-eval-region nil begin end)))))
        (dojo-probe-record "region-result" (dojo-probe-expression client
          "(submission_count, tuple(result.shape), result.device.type, id(tensor) == original_tensor_id)"))
        (dojo-probe-stop client)
        (sleep-for 1)
        (dojo-probe-start client)
        (sleep-for 1)
        (dojo-probe-record "idle-reconnect" (dojo-probe-expression client
          "(submission_count, id(tensor) == original_tensor_id, id(model) == original_model_id)"))
        (with-temp-buffer
          (setq-local jupyter-current-client client)
          (let ((request (jupyter-eval-string "import time\ntime.sleep(3)\nsubmission_count += 1\nprint('completed-once-while-disconnected')")))
            (sleep-for 0.4)
            (dojo-probe-stop client)
            (dojo-probe-record "request-idle-before-offline-wait" (jupyter-request-idle-p request))
            (sleep-for 4)
            (dojo-probe-record "request-idle-after-offline-wait" (jupyter-request-idle-p request))
            (dojo-probe-start client)
            (dojo-probe-record "original-request-idle-after-reconnect"
                               (and (jupyter-wait-until-idle request 10) t))
            (dojo-probe-record "original-request-message-types"
                               (mapcar #'jupyter-message-type (jupyter-request-messages request)))))
        (dojo-probe-record "execution-reconnect" (dojo-probe-expression client
          "(submission_count, id(tensor) == original_tensor_id, id(model) == original_model_id)"))
        (dojo-probe-stop client)
        (with-temp-buffer
          (python-mode)
          (setq second-client (jupyter-connect-server-repl server kernel-id
                              "torch-dojo-emacs-research" t nil nil))
          (dojo-probe-record "public-connect-repl-buffer" (buffer-name (oref second-client buffer)))
          (dojo-probe-record "source-buffer-associated" (eq jupyter-current-client second-client))
          (insert "assert submission_count == 2\nassert id(tensor) == original_tensor_id\nassert id(model) == original_model_id\n")
          (dojo-probe-check-request (jupyter-eval-region nil (point-min) (point-max))))
        (dojo-probe-record "new-client-existing-kernel" (dojo-probe-expression second-client
          "(submission_count, id(tensor) == original_tensor_id, id(model) == original_model_id, tuple(model(tensor).shape))"))
        (unless (equal (dojo-probe-expression second-client
                         "(submission_count, id(tensor) == original_tensor_id, id(model) == original_model_id)")
                       "(2, True, True)")
          (error "State or exactly-once count changed"))
        (dojo-probe-debug-workflow second-client)
        (dojo-probe-record "pid-before-restart" (dojo-probe-expression second-client "os.getpid()"))
        (dojo-probe-stop second-client)
        (jupyter-api-restart-kernel server kernel-id)
        (sleep-for 2)
        (setq third-client (jupyter-client (jupyter-kernel :server server :id kernel-id)
                                          'jupyter-kernel-client))
        (dojo-probe-record "pid-after-restart" (dojo-probe-expression third-client "__import__('os').getpid()"))
        (dojo-probe-record "state-after-restart" (dojo-probe-expression third-client
          "('tensor' in globals(), 'model' in globals(), 'submission_count' in globals())"))
        (unless (equal (dojo-probe-expression third-client "'tensor' in globals()") "False")
          (error "Expected restarted kernel to lose state")))
    (when third-client (ignore-errors (dojo-probe-stop third-client)))
    (when second-client (ignore-errors (dojo-probe-stop second-client)))
    (ignore-errors (jupyter-api-shutdown-kernel server kernel-id))
    (with-temp-file (concat dojo-probe-directory "evidence.json")
      (insert (json-encode (nreverse dojo-probe-evidence))))))
