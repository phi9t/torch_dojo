;;; emacs_once_probe.el --- Linear cached workout experiment -*- lexical-binding: t; -*-
(require 'cl-lib)
(require 'subr-x)
(require 'json)
(setq user-emacs-directory (expand-file-name "~/.emacs.d/"))
(let ((build (format "~/.emacs.d/.local/straight/build-%d.%d" emacs-major-version emacs-minor-version)))
  (dolist (dir (directory-files build t directory-files-no-dot-files-regexp))
    (when (file-directory-p dir) (add-to-list 'load-path dir))))
(require 'jupyter)
(require 'jupyter-server)
(require 'jupyter-messages)
(setq jupyter-eval-use-overlays nil)
(setq jupyter-eval-short-result-display-function #'message)
(defun dojo-once-check (request)
  (unless (jupyter-wait-until-idle request 60) (error "Execution incomplete"))
  (let ((reply (jupyter-find-message "execute_reply" (jupyter-request-messages request))))
    (unless (equal (plist-get (jupyter-message-content reply) :status) "ok")
      (error "Execution failed: %S" reply)))
  request)
(let* ((token (string-trim (with-temp-buffer
                            (insert-file-contents "/workspace/torch_dojo/target/insula/shared/token")
                            (buffer-string))))
       (auth `(("Authorization" . ,(concat "token " token))))
       (jupyter-api-authentication-method auth)
       (server (jupyter-server :url "http://127.0.0.1:8899" :auth auth))
       (kernel (jupyter-kernel :server server :spec "torch-dojo-gpu"))
       (client (jupyter-client kernel 'jupyter-kernel-client))
       (kernel-id (jupyter-server-kernel-id kernel))
       second-client)
  (unwind-protect
      (with-temp-buffer
        (python-mode)
        (setq-local jupyter-current-client client)
        (insert "import sys, torch\nsys.path.insert(0, '/workspace/torch_dojo/experiments/persistent-session')\nfrom once_lab import once, invalidate\nsetup_count = 0\ndef setup():\n    global setup_count\n    setup_count += 1\n    return torch.nn.Linear(16, 8).cuda(), torch.randn(4, 16, device='cuda')\n")
        (dojo-once-check (jupyter-eval-buffer (current-buffer)))
        (erase-buffer)
        (insert "from once_lab import once\nmodel, x = once('fixture', setup)\ny = model(x) + 1\nassert y.is_cuda\n")
        (dojo-once-check (jupyter-eval-buffer (current-buffer)))
        (dojo-once-check (jupyter-eval-string "identity = (id(model), id(x), x.data_ptr())\nfirst_y = y.detach().clone()"))
        (dojo-once-check (jupyter-eval-buffer (current-buffer)))
        (goto-char (point-min))
        (search-forward " + 1")
        (replace-match " + 2")
        (dojo-once-check (jupyter-eval-region nil (point-min) (point-max)))
        (dojo-once-check (jupyter-eval-string "assert setup_count == 1\nassert identity == (id(model), id(x), x.data_ptr())\nassert torch.allclose(y, first_y + 1)"))
        (jupyter-run-with-io (jupyter-kernel-io client) (jupyter-publish 'stop))
        (setq second-client (jupyter-connect-server-repl server kernel-id "torch-dojo-once-research" t nil nil))
        (unless (eq jupyter-current-client second-client) (error "REPL did not associate source buffer"))
        (dojo-once-check (jupyter-eval-buffer (current-buffer)))
        (dojo-once-check (jupyter-eval-string "assert setup_count == 1\nassert once('fixture', lambda: None) == (model, x)\nassert identity == (id(model), id(x), x.data_ptr())\ninvalidate('fixture')\nmodel, x = once('fixture', setup)\nassert setup_count == 2"))
        (with-temp-file "/workspace/torch_dojo/target/insula/research/emacs-once/evidence.json"
          (insert (json-encode `((emacs . ,emacs-version) (kernel . ,kernel-id)
                                (buffer-repeat . "pass") (edited-region . "pass")
                                (public-reattach-cache . "pass") (explicit-invalidation . "pass")))))
        (princ "PASS: Emacs buffer/region reevaluation, cached CUDA fixture, public REPL reattachment, explicit invalidation\n"))
    (when second-client (ignore-errors (jupyter-run-with-io (jupyter-kernel-io second-client) (jupyter-publish 'stop))))
    (ignore-errors (jupyter-api-shutdown-kernel server kernel-id))))
